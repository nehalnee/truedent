---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Page not found">
  <div class="wrap page">
    <span class="eyebrow">404</span>
    <h1>We couldn't find that page.</h1>
    <p class="lead">It may have moved when we rebuilt the site. Try browsing our products instead.</p>
    <a href="/products" class="btn btn-primary">Browse products <Icon name="arrow" /></a>
  </div>
</Base>

<style>
  .page {
    padding-block: 96px;
    text-align: center;
    display: grid;
    justify-items: center;
  }
</style>
