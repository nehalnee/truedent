---
import { u } from '../../lib/url';
import Base from '../../layouts/Base.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import site from '../../data/site.json';
import { products, related, facetOf, groupKey, formatPrice, slugify, type Product } from '../../lib/catalog';

export function getStaticPaths() {
  return products.map((p) => ({ params: { slug: p.slug }, props: { product: p } }));
}

const { product: p } = Astro.props as { product: Product };
const images = [p.image, ...p.gallery];
const facet = facetOf(p);
const groupLabel = p.group === 'Dental Equipment' ? 'Equipment' : 'Materials';
const ask = `Hello TrueDent, I'd like the price and availability of: ${p.name}`;
const plainSummary = (p.summary || p.description).replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
const description = plainSummary
  ? plainSummary.slice(0, 155)
  : `${p.name} - ${facet}. Available from TrueDent, dental supplies in Libya.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  image: images.map((i) => new URL(i, Astro.site).href),
  category: facet,
  ...(p.brand ? { brand: { '@type': 'Brand', name: p.brand } } : {}),
  ...(plainSummary ? { description: plainSummary } : {}),
};
---

<Base title={p.name} description={description} image={p.image}>
  <div class="wrap page">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href={u('/')}>Home</a> / <a href={u(`/products/${groupKey(p)}`)}>{groupLabel}</a> /
      <a href={u(`/products/${groupKey(p)}?type=${slugify(facet)}`)}>{facet}</a>
    </nav>

    <div class="layout">
      <div class="gallery">
        <div class="main">
          <img src={images[0]} alt={p.name} data-main width="800" height="800" />
        </div>
        {images.length > 1 && (
          <div class="thumbs">
            {images.map((src, i) => (
              <button class="thumb" data-src={src} aria-label={`Show image ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'}>
                <img src={src} alt="" loading="lazy" width="96" height="96" />
              </button>
            ))}
          </div>
        )}
      </div>

      <div class="info">
        <div class="tags">
          <span class="badge">{facet}</span>
          {p.brand && facet !== p.brand && <span class="badge">{p.brand}</span>}
          {p.comingSoon && <span class="badge badge-soon">Coming soon</span>}
        </div>
        <h1>{p.name}</h1>
        <p class="price">{formatPrice(p.price)}</p>
        {p.summary && <div class="prose summary" set:html={p.summary} />}

        <div class="buy">
          {p.comingSoon ? (
            <a class="btn btn-whatsapp" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(`Hello TrueDent, please let me know when ${p.name} is available.`)}`} target="_blank" rel="noopener">
              <Icon name="whatsapp" /> Notify me when available
            </a>
          ) : (
            <>
              <label class="qty">
                <span class="visually-hidden">Quantity</span>
                <input type="number" id="qty" min="1" max="999" value="1" inputmode="numeric" />
              </label>
              <button class="btn btn-primary" data-add-quote={p.slug} data-name={p.name} data-qty-from="#qty">
                <Icon name="plus" /> <span data-label>Add to quote</span>
              </button>
              <a class="btn btn-whatsapp" href={`https://wa.me/${site.whatsapp}?text=${encodeURIComponent(ask)}`} target="_blank" rel="noopener">
                <Icon name="whatsapp" /> Ask on WhatsApp
              </a>
            </>
          )}
        </div>

        <ul class="assure">
          <li><Icon name="check" /> Genuine products from authorised suppliers</li>
          <li><Icon name="check" /> Delivery to clinics across Libya</li>
          <li><Icon name="check" /> Call <a href={`tel:${site.phones[0].tel}`}>{site.phones[0].display}</a> for advice</li>
        </ul>

        {p.description && (
          <div class="details">
            <h2>Details</h2>
            <div class="prose" set:html={p.description} />
          </div>
        )}
      </div>
    </div>

    <section class="related">
      <div class="section-head"><h2>You may also need</h2></div>
      <div class="grid">
        {related(p).map((r) => <ProductCard product={r} />)}
      </div>
    </section>
  </div>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
</Base>

<script>
  const main = document.querySelector<HTMLImageElement>('[data-main]');
  document.querySelectorAll<HTMLButtonElement>('.thumb').forEach((t, _, all) =>
    t.addEventListener('click', () => {
      if (main) main.src = t.dataset.src!;
      all.forEach((x) => x.setAttribute('aria-pressed', String(x === t)));
    }),
  );
</script>

<style>
  .page {
    padding-block: 28px 80px;
  }
  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .crumbs a {
    color: var(--muted);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 5vw, 4rem);
    align-items: start;
  }
  @media (max-width: 820px) {
    .layout {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .gallery {
    position: sticky;
    top: 92px;
  }
  @media (max-width: 820px) {
    .gallery {
      position: static;
    }
  }
  .main {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: radial-gradient(circle at 50% 40%, #fff, var(--tint-1) 70%, var(--tint-2));
    border-radius: var(--radius-lg);
  }
  .main img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: clamp(16px, 4vw, 40px);
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .thumbs {
    display: flex;
    gap: 10px;
    margin-top: 12px;
    overflow-x: auto;
  }
  .thumb {
    flex: none;
    width: 76px;
    height: 76px;
    padding: 6px;
    border-radius: 12px;
    border: 2px solid transparent;
    background: var(--tint-1);
    cursor: pointer;
    transition: border-color 0.25s;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: multiply;
  }
  .thumb[aria-pressed='true'] {
    border-color: var(--accent);
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1rem;
  }
  .price {
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--brand);
    margin: 0 0 1rem;
  }
  .buy {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin: 1.5rem 0;
  }
  .qty input {
    width: 80px;
    height: 100%;
    min-height: 46px;
    border: 1.5px solid var(--line);
    border-radius: 999px;
    text-align: center;
    font: inherit;
    font-weight: 700;
    background: #fff;
  }
  .buy :global(.added) {
    background: var(--accent);
  }
  .assure {
    list-style: none;
    padding: 1.1rem 1.25rem;
    margin: 0 0 2rem;
    background: var(--accent-soft);
    border-radius: var(--radius);
    display: grid;
    gap: 0.45rem;
    font-size: 0.92rem;
    color: var(--ink-soft);
  }
  .assure li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .assure :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
    flex: none;
  }
  .details h2 {
    font-size: 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .related {
    margin-top: 80px;
  }
</style>
