---
import Base from '../layouts/Base.astro';
import ProductCard from '../components/ProductCard.astro';
import Features from '../components/Features.astro';
import Icon from '../components/Icon.astro';
import site from '../data/site.json';
import { products, featured, facets, GROUPS } from '../lib/catalog';

const equipmentTypes = facets('Dental Equipment');
const materialBrands = facets('Dental Material');
const counts = {
  equipment: products.filter((p) => p.group === 'Dental Equipment').length,
  materials: products.filter((p) => p.group === 'Dental Material').length,
};
const showcase = featured.slice(0, 4);
const spotlight = products.find((p) => p.slug === 'implanter')!;
---

<Base>
  <!-- Hero -->
  <section class="hero">
    <span class="mark m1" aria-hidden="true"></span>
    <span class="mark m2" aria-hidden="true"></span>
    <span class="mark m3" aria-hidden="true"></span>
    <div class="wrap hero-inner">
      <div class="stage" aria-hidden="true">
        <div class="glow"></div>
        <img class="bottle b1" src="/images/products/wpp-super-with-chlorhexidine.webp" alt="" width="603" height="1000" />
        <img class="bottle b2" src="/images/products/wpp-fast-for-fast-rapid-polishing.webp" alt="" width="635" height="1000" />
        <img class="tip t1" src="/images/products/ed6.webp" alt="" width="604" height="606" />
        <img class="tip t2" src="/images/products/ed12.webp" alt="" width="537" height="507" />
        <img class="tip t3" src="/images/products/ed62.webp" alt="" width="1000" height="815" />
      </div>
      <div class="hero-copy" data-reveal>
        <span class="eyebrow">Dental supplies · Libya</span>
        <h1>Enhancing smiles. <span>Empowering dentistry.</span></h1>
        <p class="lead">
          Premium dental equipment and materials, carefully curated for every dentist's needs and delivered across
          Libya from {site.city.split(',')[0]}.
        </p>
        <div class="hero-cta">
          <a href="/products" class="btn btn-primary">Shop products <Icon name="arrow" /></a>
          <a href={`https://wa.me/${site.whatsapp}`} class="btn btn-ghost" target="_blank" rel="noopener">
            <Icon name="whatsapp" /> WhatsApp us
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Feature strip -->
  <section class="strip">
    <div class="wrap"><Features /></div>
  </section>

  <!-- Why TrueDent -->
  <section class="section band-1 why">
    <img class="side s-left" src="/images/products/condac-porcelana.webp" alt="" width="308" height="432" loading="lazy" data-reveal />
    <img class="side s-right" src="/images/products/vittra-aps-unique-flow2.webp" alt="" width="286" height="401" loading="lazy" data-reveal style="--d:2" />
    <div class="wrap center why-copy" data-reveal style="--d:1">
      <span class="eyebrow">Why TrueDent?</span>
      <h2>Everything your practice needs, from people who understand it.</h2>
      <p class="lead">{site.description}</p>
      <p class="lead">
        From endodontic tips and apex locators to restorative materials by FGM and Nexobio, we bring trusted brands
        to Libyan clinics, with honest advice and reliable delivery.
      </p>
      <a href="/about" class="btn btn-ghost">Our story <Icon name="arrow" /></a>
    </div>
  </section>

  <!-- Product spotlight -->
  <section class="section band-white">
    <div class="wrap spotlight">
      <div class="shots" data-reveal>
        <a href={`/product/${spotlight.slug}`} class="shot main"><img src={spotlight.image} alt={spotlight.name} loading="lazy" width="1000" height="938" /></a>
        {spotlight.gallery.slice(2, 4).map((src) => (
          <a href={`/product/${spotlight.slug}`} class="shot"><img src={src} alt="" loading="lazy" width="400" height="400" /></a>
        ))}
      </div>
      <div class="spot-copy" data-reveal style="--d:1">
        <span class="eyebrow">Featured equipment</span>
        <h2>Woodpecker Implanter</h2>
        <p class="lead">
          A complete implant motor with a 7-inch colour touchscreen, silent peristaltic pump and an imported Swiss
          motor, built for precise, comfortable surgery.
        </p>
        <ul class="specs">
          <li><Icon name="check" /> 7-inch touchscreen</li>
          <li><Icon name="check" /> Silent peristaltic pump</li>
          <li><Icon name="check" /> Ergonomic contra-angle</li>
          <li><Icon name="check" /> Multifunction foot paddle</li>
        </ul>
        <div class="spot-cta">
          <a href={`/product/${spotlight.slug}`} class="btn btn-primary">View product <Icon name="arrow" /></a>
          <button class="btn btn-ghost" data-add-quote={spotlight.slug} data-name={spotlight.name}>
            <Icon name="plus" /> <span data-label>Add to quote</span>
          </button>
        </div>
      </div>
    </div>
  </section>

  <!-- Popular -->
  <section class="section band-2 popular">
    <div class="wrap">
      <div class="center" data-reveal>
        <span class="eyebrow">Hot items</span>
        <h2>Popular with our dentists</h2>
      </div>
      <div class="tilted">
        {showcase.map((p, i) => (
          <div class="tilt" data-reveal style={`--d:${i};--r:${[-3, 2, -2, 3][i]}deg`}>
            <ProductCard product={p} />
          </div>
        ))}
      </div>
      <div class="center">
        <a href="/products" class="btn btn-primary">View all {products.length} products <Icon name="arrow" /></a>
      </div>
    </div>
  </section>

  <!-- Shop by group -->
  <section class="section">
    <div class="wrap">
      <div class="groups">
        {GROUPS.map((g, i) => (
          <a href={`/products/${g.key}`} class:list={['group', g.key]} data-reveal style={`--d:${i}`}>
            <span class="count">{counts[g.key]} products</span>
            <h2>{'label' in g ? g.label : g.name}</h2>
            <p>{g.blurb}</p>
            <span class="go">Explore <Icon name="arrow" /></span>
            <img
              src={g.key === 'equipment' ? '/images/products/s-6.webp' : '/images/products/ambar-aps-universal.webp'}
              alt=""
              loading="lazy"
              width="400"
              height="300"
            />
          </a>
        ))}
      </div>

      <div class="browse" data-reveal>
        <div>
          <h3>Equipment by type</h3>
          <div class="chips">
            {equipmentTypes.map((t) => (
              <a href={`/products/equipment?type=${t.slug}`} class="chip">{t.name}</a>
            ))}
          </div>
        </div>
        <div>
          <h3>Material brands</h3>
          <div class="chips">
            {materialBrands.map((b) => (
              <a href={`/products/materials?type=${b.slug}`} class="chip">{b.name}</a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- How it works -->
  <section class="section band-white">
    <div class="wrap">
      <div class="center" data-reveal>
        <span class="eyebrow">How ordering works</span>
        <h2>Three steps, no account needed</h2>
      </div>
      <ol class="steps">
        <li data-reveal style="--d:0">
          <span class="num">01</span>
          <h3>Build your list</h3>
          <p>Add the equipment and materials you need to your quote list, with quantities.</p>
        </li>
        <li data-reveal style="--d:1">
          <span class="num">02</span>
          <h3>Send it on WhatsApp</h3>
          <p>One tap sends the full list to our team. Prefer to talk? Just call us.</p>
        </li>
        <li data-reveal style="--d:2">
          <span class="num">03</span>
          <h3>Get price &amp; delivery</h3>
          <p>We confirm current prices and availability, and deliver to your clinic.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-wrap">
    <div class="wrap">
      <div class="cta" data-reveal>
        <div>
          <h2>Need something that isn't listed?</h2>
          <p>Tell us what your clinic needs. We source dental materials and equipment on request.</p>
        </div>
        <div class="cta-actions">
          <a href={`https://wa.me/${site.whatsapp}`} class="btn btn-whatsapp" target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
          <a href={`tel:${site.phones[0].tel}`} class="btn btn-light"><Icon name="phone" /> {site.phones[0].display}</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background:
      radial-gradient(60% 70% at 25% 45%, rgb(255 255 255 / 0.75), transparent 70%),
      linear-gradient(160deg, var(--tint-1) 0%, var(--tint-2) 55%, var(--tint-3) 100%);
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: clamp(1rem, 4vw, 4rem);
    min-height: min(78vh, 720px);
    padding-block: clamp(32px, 6vw, 72px);
  }
  .hero-copy h1 {
    font-size: clamp(2.4rem, 4.8vw, 4rem);
  }
  .hero-copy h1 span {
    display: block;
    color: var(--brand);
  }
  .hero-copy .lead {
    margin-block: 1.25rem 2rem;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .stage {
    position: relative;
    aspect-ratio: 1 / 0.9;
    width: 100%;
    max-width: 560px;
    justify-self: center;
  }
  .glow {
    position: absolute;
    inset: 12% 10%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(35 178 159 / 0.28), transparent 65%);
    filter: blur(10px);
  }
  .stage img {
    position: absolute;
    filter: drop-shadow(0 30px 30px rgb(8 61 69 / 0.25));
    animation: float 7s ease-in-out infinite;
  }
  .bottle {
    width: 38%;
  }
  .b1 {
    left: 14%;
    top: 6%;
    rotate: -8deg;
  }
  .b2 {
    left: 46%;
    top: 13%;
    rotate: 7deg;
    animation-delay: -3.5s;
  }
  .tip {
    width: 20%;
    filter: drop-shadow(0 14px 14px rgb(8 61 69 / 0.2));
  }
  .t1 {
    left: 0;
    top: 2%;
    rotate: -20deg;
    animation-duration: 6s;
  }
  .t2 {
    right: 0;
    top: 0;
    rotate: 25deg;
    animation-duration: 8s;
    animation-delay: -2s;
  }
  .t3 {
    left: 34%;
    bottom: 0;
    width: 24%;
    rotate: -10deg;
    animation-duration: 9s;
    animation-delay: -5s;
  }
  /* small "+" marks, a quieter nod to the sparkles in the reference */
  .mark {
    position: absolute;
    width: 14px;
    height: 14px;
    opacity: 0.45;
    background:
      linear-gradient(var(--brand), var(--brand)) center / 2px 100% no-repeat,
      linear-gradient(var(--brand), var(--brand)) center / 100% 2px no-repeat;
  }
  .m1 {
    top: 9%;
    left: 44%;
  }
  .m2 {
    bottom: 16%;
    right: 8%;
  }
  .m3 {
    top: 22%;
    right: 14%;
    opacity: 0.25;
  }
  @media (max-width: 860px) {
    .hero-inner {
      grid-template-columns: 1fr;
      min-height: 0;
      text-align: center;
    }
    .hero-copy .eyebrow,
    .hero-cta {
      justify-content: center;
    }
    .hero-copy .lead {
      margin-inline: auto;
    }
    .stage {
      max-width: 400px;
    }
  }

  /* ---------- Feature strip ---------- */
  .strip {
    background: var(--tint-3);
    padding-block: 44px;
  }

  /* ---------- Why ---------- */
  .why {
    position: relative;
    overflow: hidden;
  }
  .why-copy {
    max-width: 760px;
  }
  .why-copy .btn {
    margin-top: 1rem;
  }
  .side {
    position: absolute;
    width: clamp(120px, 15vw, 210px);
    filter: drop-shadow(0 24px 24px rgb(8 61 69 / 0.2));
  }
  .s-left {
    left: max(2vw, calc(50% - 640px));
    top: 18%;
    rotate: -12deg;
  }
  .s-right {
    right: max(2vw, calc(50% - 620px));
    top: 26%;
    rotate: 10deg;
  }
  .js .side[data-reveal].in {
    transform: none;
  }
  @media (max-width: 1080px) {
    .side {
      display: none;
    }
  }

  /* ---------- Spotlight ---------- */
  .spotlight {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  @media (max-width: 860px) {
    .spotlight {
      grid-template-columns: 1fr;
    }
  }
  .shots {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }
  .shot {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: var(--radius);
    background: linear-gradient(160deg, var(--tint-1), var(--tint-2));
  }
  .shot img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    padding: 12%;
    transition: transform 0.6s var(--ease);
  }
  .shot:hover img {
    transform: scale(1.06);
  }
  .shot.main {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 11;
  }
  .shot.main img {
    object-fit: cover;
    padding: 0;
  }
  .specs {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 2rem;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0.75rem;
  }
  .specs li {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: 600;
    font-size: 0.92rem;
  }
  .specs :global(svg) {
    width: 22px;
    height: 22px;
    padding: 4px;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent);
    flex: none;
  }
  .spot-cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  .spot-cta :global(.added) {
    background: var(--accent);
    color: #fff;
    border-color: var(--accent);
  }

  /* ---------- Popular (tilted cards) ---------- */
  .tilted {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: clamp(14px, 2.5vw, 32px);
    margin: 3rem 0;
  }
  @media (max-width: 900px) {
    .tilted {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  .tilt {
    rotate: var(--r);
    transition: rotate 0.5s var(--ease);
  }
  .tilt:hover {
    rotate: 0deg;
  }
  .tilt :global(.card) {
    height: 100%;
    box-shadow: var(--shadow-lg);
    border-color: transparent;
  }
  @media (max-width: 520px) {
    .tilt {
      rotate: calc(var(--r) / 2);
    }
  }

  /* ---------- Groups ---------- */
  .groups {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  @media (max-width: 760px) {
    .groups {
      grid-template-columns: 1fr;
    }
  }
  .group {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 4vw, 44px);
    border-radius: var(--radius-lg);
    color: #fff;
    text-decoration: none;
    min-height: 300px;
    isolation: isolate;
  }
  .group.equipment {
    background: linear-gradient(150deg, #0f6672, var(--brand-dark));
  }
  .group.materials {
    background: linear-gradient(150deg, #24a593, #0e6b62);
  }
  .group .count {
    font-size: 0.8rem;
    font-weight: 700;
    color: rgb(255 255 255 / 0.7);
    margin-bottom: 0.75rem;
  }
  .group p {
    color: rgb(255 255 255 / 0.82);
    max-width: 34ch;
  }
  .group img {
    position: absolute;
    right: -4%;
    bottom: -6%;
    width: 46%;
    z-index: -1;
    opacity: 0.95;
    filter: drop-shadow(0 20px 30px rgb(0 0 0 / 0.3));
    transition: transform 0.7s var(--ease);
  }
  .group:hover img {
    transform: translate(-6px, -8px) rotate(-3deg) scale(1.04);
  }
  .go {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 700;
  }
  .go :global(svg) {
    width: 1.1em;
    height: 1.1em;
    transition: transform 0.3s var(--ease);
  }
  .group:hover .go :global(svg) {
    transform: translateX(4px);
  }
  .browse {
    display: grid;
    grid-template-columns: 1.4fr 1fr;
    gap: 2rem;
    margin-top: 3rem;
  }
  @media (max-width: 760px) {
    .browse {
      grid-template-columns: 1fr;
    }
  }
  .browse h3 {
    font-size: 1rem;
    margin-bottom: 0.9rem;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .chip {
    padding: 0.5rem 0.95rem;
    border-radius: 999px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.88rem;
    transition: all 0.25s var(--ease);
  }
  .chip:hover {
    border-color: var(--accent);
    color: var(--brand);
    background: var(--tint-1);
  }

  /* ---------- Steps ---------- */
  .steps {
    list-style: none;
    padding: 0;
    margin: 3rem 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  @media (max-width: 760px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
  .steps li {
    padding: 32px;
    border-radius: var(--radius);
    background: var(--tint-1);
  }
  .steps p {
    color: var(--ink-soft);
    margin: 0;
  }
  .num {
    display: block;
    font-family: var(--display);
    font-size: 2.6rem;
    font-weight: 800;
    line-height: 1;
    color: var(--tint-3);
    margin-bottom: 1rem;
  }

  /* ---------- CTA ---------- */
  .cta-wrap {
    padding-block: 0 clamp(56px, 9vw, 112px);
    background: var(--surface);
  }
  .cta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
    flex-wrap: wrap;
    padding: clamp(32px, 5vw, 56px);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(80% 120% at 100% 0%, rgb(35 178 159 / 0.35), transparent 60%),
      var(--brand);
    color: #fff;
  }
  .cta h2 {
    margin-bottom: 0.4rem;
  }
  .cta p {
    margin: 0;
    color: rgb(255 255 255 / 0.8);
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>
