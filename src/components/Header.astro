---
import { u, stripBase } from '../lib/url';
import Logo from './Logo.astro';
import Icon from './Icon.astro';

const path = stripBase(Astro.url.pathname).replace(/\/$/, '') || '/';
const left = [
  { href: '/products/equipment', label: 'Equipment' },
  { href: '/products/materials', label: 'Materials' },
  { href: '/products', label: 'All products' },
];
const right = [
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href: string) => (href === '/products' ? path === href : path.startsWith(href));
---

<header class="header" data-header>
  <div class="wrap header-inner">
    <nav class="nav nav-left" aria-label="Products">
      {left.map((l) => (
        <a href={u(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
      ))}
    </nav>

    <a href={u('/')} class="home" aria-label="TrueDent home"><Logo /></a>

    <div class="nav-right">
      <nav class="nav" aria-label="Company">
        {right.map((l) => (
          <a href={u(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
        ))}
      </nav>
      <a href={u('/quote')} class="quote-link" aria-label="Quote list">
        <Icon name="cart" />
        <span class="quote-text">Quote</span>
        <span class="count" data-quote-count hidden>0</span>
      </a>
      <button class="menu" aria-controls="mobile-nav" aria-expanded="false" aria-label="Menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <nav class="mobile-nav" id="mobile-nav" aria-label="Main">
    {[...left, ...right].map((l) => (
      <a href={u(l.href)} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a>
    ))}
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const btn = header.querySelector<HTMLButtonElement>('.menu')!;
  btn.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    header.classList.toggle('open', open);
  });
  const onScroll = () => header.classList.toggle('scrolled', scrollY > 8);
  addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(246 250 249 / 0.72);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
    border-bottom: 1px solid transparent;
    transition:
      border-color 0.3s,
      background 0.3s;
  }
  .header:global(.scrolled) {
    background: rgb(255 255 255 / 0.85);
    border-color: var(--line);
  }
  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1.5rem;
    height: 76px;
  }
  .home {
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 0.15rem;
  }
  .nav a,
  .mobile-nav a {
    position: relative;
    padding: 0.5rem 0.85rem;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.92rem;
    transition: color 0.2s;
  }
  .nav a::after {
    content: '';
    position: absolute;
    left: 0.85rem;
    right: 0.85rem;
    bottom: 0.25rem;
    height: 2px;
    border-radius: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s var(--ease);
  }
  .nav a:hover {
    color: var(--brand);
  }
  .nav a:hover::after,
  .nav a[aria-current='page']::after {
    transform: scaleX(1);
  }
  .nav a[aria-current='page'] {
    color: var(--brand);
  }
  .nav-right {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
  }
  .quote-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.1rem;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.9rem;
    box-shadow: 0 10px 22px -12px rgb(12 85 96 / 0.7);
    transition:
      background 0.25s,
      transform 0.25s var(--ease);
  }
  .quote-link:hover {
    background: var(--brand-dark);
    transform: translateY(-1px);
  }
  .quote-link :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .count {
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--accent);
    font-size: 0.75rem;
    display: inline-grid;
    place-items: center;
  }
  .count[hidden] {
    display: none;
  }
  .menu {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    padding: 10px;
  }
  .mobile-nav {
    display: none;
  }

  @media (max-width: 960px) {
    .header-inner {
      grid-template-columns: auto 1fr;
      height: 68px;
    }
    .nav-left,
    .nav-right .nav {
      display: none;
    }
    .menu {
      display: block;
    }
    .header:global(.open) .mobile-nav {
      display: flex;
    }
    .mobile-nav {
      flex-direction: column;
      padding: 0.5rem 20px 1.25rem;
      background: #fff;
      border-bottom: 1px solid var(--line);
    }
    .mobile-nav a {
      padding: 0.85rem 0.25rem;
      font-size: 1rem;
      border-bottom: 1px solid var(--tint-1);
    }
    .mobile-nav a[aria-current='page'] {
      color: var(--brand);
    }
  }
  @media (max-width: 420px) {
    .quote-text {
      display: none;
    }
  }
</style>
