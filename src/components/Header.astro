---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import site from '../data/site.json';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { href: '/products/equipment', label: 'Equipment' },
  { href: '/products/materials', label: 'Materials' },
  { href: '/products', label: 'All products' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isActive = (href: string) => (href === '/products' ? path === href : path.startsWith(href));
---

<div class="topbar">
  <div class="wrap topbar-inner">
    <span>Dental materials &amp; equipment · {site.city}</span>
    <span class="topbar-phones">
      {site.phones.map((p) => <a href={`tel:${p.tel}`}>{p.display}</a>)}
    </span>
  </div>
</div>
<header class="header">
  <div class="wrap header-inner">
    <a href="/" class="home" aria-label="TrueDent home"><Logo /></a>

    <nav class="nav" id="site-nav" aria-label="Main">
      {links.map((l) => (
        <a href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <div class="actions">
      <a href="/quote" class="quote-link" aria-label="Quote list">
        <Icon name="cart" />
        <span class="quote-text">Quote</span>
        <span class="count" data-quote-count hidden>0</span>
      </a>
      <button class="menu" aria-controls="site-nav" aria-expanded="false" aria-label="Menu">
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.menu')!;
  const nav = document.getElementById('site-nav')!;
  btn.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
  });
</script>

<style>
  .topbar {
    background: var(--brand-dark);
    color: #cfe5e2;
    font-size: 0.82rem;
  }
  .topbar-inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.45rem;
  }
  .topbar a {
    color: #fff;
    text-decoration: none;
    font-weight: 600;
  }
  .topbar-phones {
    display: flex;
    gap: 1.2rem;
  }
  @media (max-width: 640px) {
    .topbar-inner > span:first-child {
      display: none;
    }
    .topbar-phones {
      width: 100%;
      justify-content: center;
    }
  }

  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(255 255 255 / 0.92);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 68px;
  }
  .home {
    text-decoration: none;
  }
  .nav {
    display: flex;
    gap: 0.25rem;
    margin-left: auto;
  }
  .nav a {
    padding: 0.5rem 0.8rem;
    border-radius: 8px;
    color: var(--ink-soft);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .nav a:hover {
    color: var(--brand);
    background: var(--bg);
  }
  .nav a[aria-current='page'] {
    color: var(--brand);
    background: var(--accent-soft);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .quote-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: var(--brand);
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.92rem;
  }
  .quote-link :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }
  .count {
    min-width: 1.35rem;
    height: 1.35rem;
    padding: 0 0.3rem;
    border-radius: 999px;
    background: var(--accent);
    font-size: 0.75rem;
    display: inline-grid;
    place-items: center;
  }
  .count[hidden] {
    display: none;
  }
  .menu {
    display: none;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 10px;
    background: #fff;
    color: var(--ink);
    cursor: pointer;
    padding: 9px;
  }

  @media (max-width: 900px) {
    .header-inner {
      justify-content: space-between;
    }
    .menu {
      display: block;
    }
    .nav {
      display: none;
      position: absolute;
      top: 68px;
      left: 0;
      right: 0;
      flex-direction: column;
      padding: 0.75rem 20px 1.25rem;
      background: #fff;
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .nav.open {
      display: flex;
    }
    .nav a {
      padding: 0.8rem;
    }
  }
  @media (max-width: 420px) {
    .quote-text {
      display: none;
    }
  }
</style>
