---
import Icon from './Icon.astro';
import { facetOf, formatPrice, slugify, type Product } from '../lib/catalog';

interface Props {
  product: Product;
}
const { product: p } = Astro.props;
const facet = facetOf(p);
---

<article class="card" data-facet={slugify(facet)}>
  <a href={`/product/${p.slug}`} class="media">
    <img src={p.image} alt={p.name} loading="lazy" width="400" height="400" />
    {p.comingSoon && <span class="badge badge-soon tag">Coming soon</span>}
  </a>
  <div class="body">
    <span class="facet">{facet}</span>
    <h3><a href={`/product/${p.slug}`}>{p.name}</a></h3>
    <div class="foot">
      <span class="price">{formatPrice(p.price)}</span>
      {!p.comingSoon && (
        <button class="add" data-add-quote={p.slug} data-name={p.name} aria-label={`Add ${p.name} to quote`}>
          <Icon name="plus" />
        </button>
      )}
    </div>
  </div>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
    transition: box-shadow 0.2s, transform 0.2s, border-color 0.2s;
  }
  .card:hover {
    box-shadow: var(--shadow);
    border-color: transparent;
    transform: translateY(-2px);
  }
  .media {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    background: linear-gradient(180deg, #fff, #f1f6f5);
  }
  .media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    padding: 18px;
    object-fit: contain;
    transition: transform 0.3s;
  }
  .card:hover .media img {
    transform: scale(1.04);
  }
  .tag {
    position: absolute;
    top: 12px;
    left: 12px;
  }
  .body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    padding: 14px 16px 16px;
    flex: 1;
    border-top: 1px solid var(--line);
  }
  .facet {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--accent);
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  h3 {
    font-size: 1rem;
    margin: 0;
  }
  h3 a {
    color: var(--ink);
    text-decoration: none;
  }
  h3 a:hover {
    color: var(--brand);
  }
  .foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.6rem;
  }
  .price {
    font-size: 0.85rem;
    color: var(--muted);
    font-weight: 600;
  }
  .add {
    width: 36px;
    height: 36px;
    flex: none;
    border-radius: 50%;
    border: 0;
    background: var(--accent-soft);
    color: var(--brand);
    cursor: pointer;
    padding: 9px;
    transition: background 0.15s, color 0.15s;
  }
  .add:hover,
  .add:global(.added) {
    background: var(--accent);
    color: #fff;
  }
  @media (max-width: 520px) {
    .body {
      padding: 10px 12px 12px;
    }
    h3 {
      font-size: 0.9rem;
    }
    .price {
      font-size: 0.75rem;
    }
  }
</style>
