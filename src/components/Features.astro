---
import Icon from './Icon.astro';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;

const items = [
  { icon: 'shield', title: 'Genuine products', text: 'From authorised suppliers' },
  { icon: 'truck', title: 'Libya-wide delivery', text: 'Straight to your clinic' },
  { icon: 'chat', title: 'Expert advice', text: 'Talk to people who know dentistry' },
  { icon: 'whatsapp', title: 'Order on WhatsApp', text: 'Send your list in one tap' },
] as const;
---

<ul class:list={['features', { compact }]}>
  {items.map((f, i) => (
    <li data-reveal style={`--d:${i}`}>
      <span class="icon"><Icon name={f.icon} /></span>
      <strong>{f.title}</strong>
      {!compact && <span class="text">{f.text}</span>}
    </li>
  ))}
</ul>

<style>
  .features {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    text-align: center;
  }
  @media (max-width: 760px) {
    .features {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem 1rem;
    }
  }
  li {
    display: grid;
    justify-items: center;
    gap: 0.2rem;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    margin-bottom: 0.75rem;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.65);
    color: var(--brand);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.9);
    transition: transform 0.4s var(--ease);
  }
  li:hover .icon {
    transform: translateY(-4px) rotate(-6deg);
  }
  .icon :global(svg) {
    width: 30px;
    height: 30px;
  }
  strong {
    font-family: var(--display);
    font-size: 1.05rem;
    color: var(--brand-dark);
    letter-spacing: -0.01em;
  }
  .text {
    font-size: 0.88rem;
    color: var(--ink-soft);
  }

  .compact {
    grid-template-columns: repeat(4, auto);
    justify-content: start;
    gap: 1.25rem 1.75rem;
  }
  .compact .icon {
    width: 48px;
    height: 48px;
    margin-bottom: 0.4rem;
    background: var(--tint-1);
  }
  .compact .icon :global(svg) {
    width: 22px;
    height: 22px;
  }
  .compact strong {
    font-size: 0.8rem;
    font-family: var(--font);
    font-weight: 700;
    max-width: 10ch;
    line-height: 1.25;
  }
  @media (max-width: 480px) {
    .compact {
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
