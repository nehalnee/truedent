---
interface Props {
  light?: boolean;
}
const { light = false } = Astro.props;
---

<span class:list={['logo', { light }]}>
  <svg viewBox="0 0 64 64" aria-hidden="true">
    <path
      d="M32 17c-3-2.6-6.7-3.6-10.2-2.6-5 1.4-7.6 6.4-6.6 12.2.8 4.5 2.7 7.6 3.8 12 1 4.2 1.4 9.8 4.8 10.4 3.4.6 3.8-5.2 4.8-9 .6-2.4 1.8-3.4 3.4-3.4s2.8 1 3.4 3.4c1 3.8 1.4 9.6 4.8 9 3.4-.6 3.8-6.2 4.8-10.4 1.1-4.4 3-7.5 3.8-12 1-5.8-1.6-10.8-6.6-12.2-3.5-1-7.2 0-10.2 2.6Z"
      fill="currentColor"></path>
    <path d="M26 24.5c2-.9 4-.6 6 .9" fill="none" stroke="var(--accent)" stroke-width="3" stroke-linecap="round"></path>
  </svg>
  <span class="word">True<b>Dent</b></span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--brand);
    font-weight: 800;
    font-size: 1.35rem;
    letter-spacing: -0.03em;
  }
  .logo svg {
    width: 2rem;
    height: 2rem;
  }
  .word b {
    color: var(--accent);
    font-weight: 800;
  }
  .light {
    color: #fff;
  }
</style>
