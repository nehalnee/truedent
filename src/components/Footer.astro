---
import { u } from '../lib/url';
import Icon from './Icon.astro';
import site from '../data/site.json';
import { facets } from '../lib/catalog';

const equipment = facets('Dental Equipment').slice(0, 5);
const brands = facets('Dental Material');
---

<footer class="footer">
  <div class="wrap top">
    <div class="intro">
      <p class="tag">Dental materials &amp; equipment, delivered across Libya.</p>
      <div class="contact">
        <a href={`https://wa.me/${site.whatsapp}`} target="_blank" rel="noopener" class="pill wa"><Icon name="whatsapp" /> WhatsApp</a>
        {site.phones.map((p) => <a href={`tel:${p.tel}`} class="pill"><Icon name="phone" /> {p.display}</a>)}
      </div>
      <p class="meta">
        <a href={`mailto:${site.email}`}>{site.email}</a> · {site.city}
      </p>
    </div>
    <nav class="cols" aria-label="Footer">
      <div>
        <h3>Shop</h3>
        <ul>
          <li><a href={u('/products/equipment')}>Equipment</a></li>
          <li><a href={u('/products/materials')}>Materials</a></li>
          <li><a href={u('/products')}>All products</a></li>
          <li><a href={u('/quote')}>Quote list</a></li>
        </ul>
      </div>
      <div>
        <h3>Equipment</h3>
        <ul>
          {equipment.map((f) => <li><a href={u(`/products/equipment?type=${f.slug}`)}>{f.name}</a></li>)}
        </ul>
      </div>
      <div>
        <h3>Brands</h3>
        <ul>
          {brands.map((f) => <li><a href={u(`/products/materials?type=${f.slug}`)}>{f.name}</a></li>)}
          <li><a href={u('/about')}>About us</a></li>
          <li><a href={u('/contact')}>Contact</a></li>
        </ul>
      </div>
    </nav>
  </div>

  <div class="wrap">
    <p class="wordmark" aria-hidden="true">True<span>Dent</span></p>
  </div>

  <div class="wrap bottom">
    <span>© {new Date().getFullYear()} {site.name}. All rights reserved.</span>
    <span>Product names and logos belong to their respective manufacturers.</span>
  </div>
</footer>

<style>
  .footer {
    background: linear-gradient(180deg, var(--tint-2), var(--tint-3));
    color: var(--ink-soft);
    padding-top: clamp(56px, 8vw, 88px);
    font-size: 0.93rem;
    overflow: hidden;
  }
  .top {
    display: grid;
    grid-template-columns: 1fr 1.3fr;
    gap: 3rem;
  }
  @media (max-width: 860px) {
    .top {
      grid-template-columns: 1fr;
    }
  }
  .tag {
    font-family: var(--display);
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 700;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--brand-dark);
    max-width: 18ch;
    margin: 0 0 1.5rem;
  }
  .contact {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 1rem;
    border-radius: 999px;
    background: rgb(255 255 255 / 0.7);
    color: var(--brand-dark);
    font-weight: 700;
    text-decoration: none;
    transition:
      background 0.25s,
      transform 0.25s var(--ease);
  }
  .pill:hover {
    background: #fff;
    transform: translateY(-1px);
  }
  .pill :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--brand);
  }
  .pill.wa :global(svg) {
    color: #1fa855;
  }
  .meta {
    margin-top: 1rem;
  }
  .meta a {
    color: var(--brand-dark);
    font-weight: 600;
  }
  .cols {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  @media (max-width: 520px) {
    .cols {
      grid-template-columns: 1fr 1fr;
    }
  }
  h3 {
    font-family: var(--font);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--brand);
    margin-bottom: 1rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  ul a {
    color: var(--ink);
    text-decoration: none;
    transition: color 0.2s;
  }
  ul a:hover {
    color: var(--brand);
  }
  .wordmark {
    margin: clamp(40px, 6vw, 72px) 0 0;
    font-family: var(--display);
    font-weight: 800;
    font-size: clamp(4rem, 27vw, 23rem);
    line-height: 0.8;
    letter-spacing: -0.06em;
    color: var(--brand);
    white-space: nowrap;
    user-select: none;
  }
  .wordmark span {
    color: rgb(255 255 255 / 0.7);
  }
  .bottom {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
    padding-block: 1.5rem;
    border-top: 1px solid rgb(12 85 96 / 0.12);
    font-size: 0.8rem;
    color: var(--ink-soft);
  }
</style>
